# Server Configuration
PROJECT_NAME="Audio & Video Translation Platform"
DEBUG=True
ALLOWED_ORIGINS=["http://localhost:3000"]

# Database Configuration (PostgreSQL 16)
DATABASE_URL="postgresql+asyncpg://postgres:postgres_secure_pass@localhost:5432/translation_db"
SYNC_DATABASE_URL="postgresql://postgres:postgres_secure_pass@localhost:5432/translation_db"

# Cache & Task Broker (Redis 7)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Google Cloud Storage (uses Application Default Credentials / Cloud Run identity)
STORAGE_PROVIDER="gcs"
GCS_BUCKET_NAME="translation-app-media-prod"
GCS_EXPORTS_BUCKET="translation-app-media-exports"
GCS_SIGNING_SERVICE_ACCOUNT="your-runtime-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
GOOGLE_CLOUD_PROJECT="your-google-cloud-project-id"

# Cloud Run / production runtime controls
DEPLOYMENT_ENV="development"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_RECYCLE_SECONDS=1800
ENABLE_BACKGROUND_PIPELINES=True

# Media Handling Limits
MAX_FILE_SIZE_BYTES=4294967296
MULTIPART_CHUNK_SIZE_BYTES=8388608
MAX_CONCURRENT_UPLOADS=20

# AI Provider API Keys
# Set to "google" after configuring GOOGLE_CLOUD_PROJECT and GOOGLE_APPLICATION_CREDENTIALS.
TRANSLATION_PROVIDER="openai"
DEEPGRAM_API_KEY="your_deepgram_api_key"
OPENAI_API_KEY="your_openai_api_key"
ELEVENLABS_API_KEY="your_elevenlabs_api_key"
REPLICATE_API_TOKEN="your_replicate_api_token"

# Security & Secrets
JWT_SECRET_KEY="super-secret-jwt-signing-key-generate-strong-key-here"
JWT_ALGORITHM="HS256"
WEBHOOK_SECRET="shared-secret-for-inbound-webhooks"

# Google-backed auth bootstrap
AUTH_PROVIDER="identity_platform"
GOOGLE_OAUTH_CLIENT_IDS=["your-web-client-id.apps.googleusercontent.com"]
ALLOW_INSECURE_DEV_AUTH=False
